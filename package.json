{
  "name": "instagram-dashboard",
  "version": "1.0.0",
  "description": "Local AI dashboard that diagnoses Instagram Reels funnel bottlenecks from Graph API metrics and emails a daily best/worst report.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node scripts/seed-demo.mjs",
    "postinstall": "node -e \"(async()=>{const fs=require('node:fs');fs.mkdirSync('data',{recursive:true});if(fs.existsSync('scripts/postinstall.mjs'))await import('./scripts/postinstall.mjs')})().catch(error=>{console.error(error);process.exit(1)})\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jdh4601/instagram-dashboard.git"
  },
  "keywords": [
    "instagram",
    "reels",
    "analytics",
    "dashboard",
    "graph-api",
    "nextjs",
    "ai",
    "llm"
  ],
  "author": "DongHyun Jung",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/jdh4601/instagram-dashboard/issues"
  },
  "homepage": "https://github.com/jdh4601/instagram-dashboard#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "lucide-react": "^1.22.0",
    "next": "^15.5.21",
    "openai": "^6.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.9.0",
    "resend": "^6.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3"
  }
}
