<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  사용법: 이 파일을 복사한 뒤 아래 두 자리표시자를 본인 환경에 맞게 바꾸세요.
    __LABEL__        예: com.yourname.instagram-report (역도메인 형식 권장)
    __PROJECT_DIR__  이 저장소의 절대경로. 예: /path/to/ai-reels-analyzer
  그런 다음 ~/Library/LaunchAgents/ 로 복사하고 launchctl load 하세요(README 참고).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- 매일 08:00 실행. 절전 중이었으면 깨어난 직후 실행됨(RunAtLoad 아님). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_DIR__/scripts/daily-report.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PROJECT_DIR</key>
        <string>__PROJECT_DIR__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/data/daily-report.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/data/daily-report.log</string>
</dict>
</plist>
