<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.done.instagram-report</string>

    <!-- 매일 08:00 실행. 절전 중이었으면 깨어난 직후 실행됨(RunAtLoad 아님). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jayden/Developer/instagram-dashboard/scripts/daily-report.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PROJECT_DIR</key>
        <string>/Users/jayden/Developer/instagram-dashboard</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/jayden/Developer/instagram-dashboard/data/daily-report.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jayden/Developer/instagram-dashboard/data/daily-report.log</string>
</dict>
</plist>
