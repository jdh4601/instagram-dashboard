# Instagram 토큰과 LLM API 키는 대시보드 설정 화면(/settings)에서 추가하는 것을 권장합니다.
# (data/settings.json 에 로컬 저장)
#
# 아래 env 변수는 선택 사항(하위 호환 폰백)입니다. 설정 화면에 키가 없을 때만 사용됩니다.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Docker 등에서 QR 코드로 폰 접속 시 사용할 서버 주소
# 컨테이너 낸부 IP가 아닌, 팀원들이 접속할 호스트 머신의 LAN IP를 지정하세요.
# 예: LAN_HOST=http://192.168.0.25:3000
LAN_HOST=

# ── 매일 아침 자동 리포트 (launchd 스케줄러) ──────────────────────────
# 크론 엔드포인트 보호용 시크릿. 임의의 긴 문자열로 설정하세요.
# 예: openssl rand -hex 32
CRON_SECRET=

# Resend (https://resend.com) 이메일 발송 설정
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# 발신 주소(Resend에서 인증한 도메인). 예: report@yourdomain.com
REPORT_EMAIL_FROM=
# 수신 주소. 여러 명은 콤마로 구분. 예: a@corp.com, b@corp.com
REPORT_EMAIL_TO=

# launchd 스케줄러가 호출할 리포트 엔드포인트 (기본값 사용 시 생략 가능)
REPORT_URL=http://localhost:3000/api/cron/daily-report
