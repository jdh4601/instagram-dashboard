# Instagram 토큰과 LLM API 키는 대시보드 설정 화면(/settings)에서 추가하는 것을 권장합니다.
# (data/settings.json 에 로컬 저장)
#
# 아래 env 변수는 선택 사항(하위 호환 폰백)입니다. 설정 화면에 키가 없을 때만 사용됩니다.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── 데이터 저장 위치 (선택) ───────────────────────────────────────────
# 기본값은 저장소 루트의 data/. 상대 경로는 앱 실행 디렉터리를 기준으로 해석합니다.
# Docker Compose는 컨테이너 내부 /app/data를 사용하므로 변경할 필요가 없습니다.
DATA_DIR=

# JSON(기본), SQLite(단일 서버), PostgreSQL(다중 인스턴스) 중 선택합니다.
STORAGE_ADAPTER=json
# STORAGE_ADAPTER=sqlite일 때만 선택. 비우면 DATA_DIR/instagram-dashboard.sqlite.
SQLITE_DATABASE_PATH=
# STORAGE_ADAPTER=postgres일 때 필수. 예: postgres://user:password@host:5432/database
DATABASE_URL=

# ── Instagram OAuth (선택, 수동 토큰 입력도 계속 지원) ────────────────
# 세 값을 모두 설정하면 /settings에 "Instagram으로 연결" 버튼이 활성화됩니다.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Meta 앱에도 한 글자까지 동일하게 등록하세요. localhost 외에는 HTTPS만 허용됩니다.
# 예: http://localhost:3000/api/auth/instagram/callback
INSTAGRAM_OAUTH_REDIRECT_URI=
# 다중 인스턴스/서버리스에서는 OAuth 파일 저장 대신 플랫폼 secret으로 장기 토큰을 주입할 수 있습니다.
INSTAGRAM_ACCESS_TOKEN=

# ── 대시보드 접근 제한 (Basic Auth) ──────────────────────────────────
# 배포된 URL을 아는 누구나 대시보드/설정 화면에 접근할 수 있으므로, 공개 배포 시
# 반드시 설정하세요. 하나만 설정하면 앱이 503으로 닫히며, 둘 다 있어야 인증됩니다.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# ── 매일 아침 자동 리포트 (launchd 스케줄러 / Vercel Cron) ────────────
# 크론 엔드포인트 보호용 시크릿. 임의의 긴 문자열로 설정하세요.
# 예: openssl rand -hex 32
# 호스팅 플랫폼의 스케줄러는 Authorization: Bearer <값>, launchd/crontab은
# x-cron-secret 헤더로 전달할 수 있으며 라우트가 둘 다 허용합니다.
CRON_SECRET=

# Resend (https://resend.com) 이메일 발송 설정 — 무료 티어(일 100통)로 충분합니다.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# 발신 주소(Resend에서 인증한 도메인). 예: report@yourdomain.com
REPORT_EMAIL_FROM=
# 수신 주소. 여러 명은 콤마로 구분. 예: a@corp.com, b@corp.com
REPORT_EMAIL_TO=

# launchd 스케줄러가 호출할 리포트 엔드포인트 (기본값 사용 시 생략 가능, Vercel 배포 시 불필요)
REPORT_URL=http://localhost:3000/api/cron/daily-report
